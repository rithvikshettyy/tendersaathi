SERPAPI_KEY=
SARVAM_API_KEY=
# You.com Search API (drill-in research). Override YDC_SEARCH_URL if the docs show a different endpoint.
YDC_API_KEY=
YDC_SEARCH_URL=https://ydc-index.io/v1/search
# WhatsApp Cloud API. WA_TOKEN must be a permanent System User token (test tokens expire in 24h).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
GRAPH_VERSION=v21.0
TEMPLATE_LANG=en
# Your number, digits with country code, e.g. 919876543210
OWNER_PHONE=
# Shared secret for cron-job.org (header X-Cron-Secret)
CRON_SECRET=
SERP_LIVE=1
GEM_LIVE=0
# Set to 0 when deployed so strangers can't register and burn SerpApi credits
PUBLIC_REGISTER=1
